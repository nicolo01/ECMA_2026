data("trees")
head(trees)
hist(trees$Volume)
hist(trees$Volume^2)
#la regressione nel complesso non viene male, ma se volessimo essere "perfetti", proseguiamo e usiamo il boxcox per agire sul fatto che la distribuzione iniziale del volume degli alberi non era normale. Poi gli controllo i valori di lambda e ho zoommato il grafico tra 0 e 0.5.Così mi sono aiutato a trovare il valore a cui elevare y.
library(MASS)
?boxcox
bctrans <- boxcox(Volume ~ Height + Girth, data = trees)
bctrans <- boxcox(Volume ~ Height + Girth, data = trees,
lambda = seq(0, 0.5, length = 10))
bctrans
which(bctrans$y==max(bctrans$y))  #dove si trova il picco
bctrans$x[62]#lambda è l'esponente a cui vado ad elevare il volume
hist(trees$Volume)
hist(trees$Volume^0.31)
max(bctrans$y)
library(dplyr)
risultati.bc <- data.frame(bctrans$y, bctrans$x)
head(risultati.bc)
arrange(risultati.bc, bctrans.y)
trees %>%
mutate(Volume, bc=Volume^0.31) ->trees.bc
mod.new<-lm(Volume, bc=Volume^0.31) ->trees.bc)
data("trees")
head(trees)
hist(trees$Volume)
hist(trees$Volume^2)
#la regressione nel complesso non viene male, ma se volessimo essere "perfetti", proseguiamo e usiamo il boxcox per agire sul fatto che la distribuzione iniziale del volume degli alberi non era normale. Poi gli controllo i valori di lambda e ho zoommato il grafico tra 0 e 0.5.Così mi sono aiutato a trovare il valore a cui elevare y.
library(MASS)
?boxcox
bctrans <- boxcox(Volume ~ Height + Girth, data = trees)
bctrans <- boxcox(Volume ~ Height + Girth, data = trees,
lambda = seq(0, 0.5, length = 10))
bctrans
which(bctrans$y==max(bctrans$y))  #dove si trova il picco
bctrans$x[62]#lambda è l'esponente a cui vado ad elevare il volume
hist(trees$Volume)
hist(trees$Volume^0.31)
max(bctrans$y)
library(dplyr)
risultati.bc <- data.frame(bctrans$y, bctrans$x)
head(risultati.bc)
arrange(risultati.bc, bctrans.y)
trees %>%
mutate(Volume.bc=Volume^0.31) ->trees.bc
mod.new<-lm(Volume.bc ~ Height + Girth, data = trees.bc)
summary(mod.new)
#vado a creare questo nuovo modello
# load the data
data(trees) # this is a dataframe
class(trees)
head(trees)
str(trees)
# normality test
shapiro.test(trees$Girth)
qqnorm(trees$Girth); qqline(trees$Girth)
# normality test
shapiro.test(trees$Volume)
qqnorm(trees$Volume); qqline(trees$Volume)
mod <- lm(Volume ~ Girth + Height, data=trees)
summary(mod)
# the mean increase in volume when there is a one-unit increase in girth is 4.7
# Volume.tr <- trees$Volume^0.30
# mod.tr <- lm(Volume.tr ~ Girth + Height, data=trees)
# summary(mod.tr)
plot(Volume ~ Girth, data=trees)
mod.q <- lm(Volume ~ Girth + I(Girth^2) +
Height + I(Height^2),
data=trees)
summary(mod.q)
# alternative code:
mod.q <- lm(Volume ~ poly(Girth, 2, raw=TRUE) + poly(Height, 2, raw=TRUE), data=trees)
summary(mod.q)
plot(Volume ~ Girth, data=trees)
mod.q <- lm(Volume ~ Girth + I(Girth^2) +
Height + I(Height^2),
data=trees)
summary(mod.q)
# alternative code:
mod.q <- lm(Volume ~ poly(Girth, 2, raw=TRUE) + poly(Height, 2, raw=TRUE), data=trees)
summary(mod.q)
plot(Volume ~ Girth, data=trees)
mod.q <- lm(Volume ~ Girth + I(Girth^2) +
Height + I(Height^2),
data=trees)
summary(mod.q)
# alternative code:
mod.q.poly <- lm(Volume ~ poly(Girth, 2, raw=TRUE) + poly(Height, 2, raw=TRUE), data=trees)
summary(mod.q.poly)
mod.int <- lm(Volume ~ Girth * Height, data=trees)
summary(mod.int)
mod <- lm(Volume ~ Girth * Height, data=trees)
plot(mod)
plot(trees$Volume ~ trees$Girth)
plot(trees$Volume ~ trees$Height)
plot_model(mod, type = "eff", terms = "Height")
plot_model(mod, type = "eff", terms = "Girth")
plot_model(mod, type = "eff", terms = "Girth")
library(sjPlot)
# plot_model(mod)
plot_model(mod, type = "eff", terms = "Height")
library(sjPlot)
# plot_model(mod)
plot_model(mod, type = "eff", terms = "Girth")
plot_model(mod, type = "eff", terms = "Height")
plot_model(mod.int, type = "eff", terms = "Height")
plot_model(mod.int, type = "int", terms = c("Height","Girth")) # # type = "int" automatically selects groups for continuous moderator variables
library(jtools)
plot_model(mod.int, type = "pred", terms = c("Girth", "Height [60,80]"))
# switch moderator
plot_model(mod.int, type = "pred", terms = c("Height", "Girth"))
AIC(mod.poly.int)
